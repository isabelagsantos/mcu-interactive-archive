set_engine("glm", family = stats::binomial(link = "probit"))
cloglog <- logistic_reg() |>
set_engine("glm", family = stats::binomial(link = "cloglog"))
# preditores x ligações
modelos <- workflow_set(
preproc = formulas,
models = list(
logit = logit,
probit = probit,
cloglog = cloglog
)
)
metricas_prob <- metric_set(roc_auc, brier_class, accuracy)
ctrl <- control_resamples(save_pred = TRUE)
resultados <- workflow_map(
modelos,
fn = "fit_resamples",
resamples = vfolds,
metrics = metricas_prob,
control = ctrl,
verbose = TRUE
)
metricas_cv <- collect_metrics(resultados)
metricas_cv |>
filter(.metric == "roc_auc") |>
arrange(desc(mean)) |>
select(Candidato = wflow_id, AUC = mean, `Erro padrão` = std_err) |>
kable(digits = 4, caption = "AUC médio na validação cruzada, por candidato")
# métricas médias dos dois finalistas
metricas_cv |>
filter(wflow_id %in% c("duas_inter_logit", "classe_sexo_logit")) |>
select(Candidato = wflow_id, Métrica = .metric, Média = mean, `Erro padrão` = std_err) |>
arrange(Métrica, Candidato) |>
kable(digits = 4, caption = "Métricas na validação cruzada: duas_inter vs. classe_sexo")
#| echo: false
melhor_modelo <- metricas_cv |>
filter(.metric == "roc_auc") |>
slice_max(order_by = mean, n = 1, with_ties = FALSE)
melhor_id <- "classe_sexo_logit"
melhor <- extract_workflow(resultados, id = melhor_id)
# ajuste no treino e extração do glm
final <- melhor |>
fit(data = treino)
final_glm <- final |>
extract_fit_parsnip() |>
extract_fit_engine()
link_final <- str_extract(melhor_id, "(logit|probit|cloglog)$")
# guardando os valores
valor_cv <- function(id, met) {
metricas_cv$mean[metricas_cv$wflow_id == id & metricas_cv$.metric == met]
}
auc_final <- valor_cv("classe_sexo_logit", "roc_auc")
auc_aditivo <- valor_cv("aditivo_logit", "roc_auc")
brier_final <- valor_cv("classe_sexo_logit", "brier_class")
brier_aditivo <- valor_cv("aditivo_logit", "brier_class")
acc_final <- valor_cv("classe_sexo_logit", "accuracy")
acc_aditivo <- valor_cv("aditivo_logit", "accuracy")
#| fig-height: 6
# o ggresiduals() procura um objeto chamado "fit" no ambiente:
modelo_final <- glm(vivo ~ classe * sexo + idade, data = treino, family = binomial)
fit <- modelo_final
set.seed(2026)
reglin::ggresiduals(fit)
shapiro.test(qresiduals(fit))
# alavancagem e distância de cook:
h <- hatvalues(fit)
cook <- cooks.distance(fit)
n <- nrow(treino)
p <- length(coef(fit))
# critérios: h >= 3p/n e cook > F(0.5; p, n - p)
corte_h <- 3 * p / n
corte_cook <- qf(0.5, p, n - p)
sum(h >= corte_h)
sum(cook > corte_cook)
max(cook)
#| fig-height: 4
reglin::gginfluence(fit, measure = "cooksd")
# observações mais influentes:
ord_cook <- order(cook, decreasing = TRUE)
data.frame(treino[ord_cook[1:6], c("vivo", "classe", "sexo", "idade")], cook = cook[ord_cook[1:6]])
# gvif no modelo de efeitos principais:
modelo_aditivo <- glm(vivo ~ classe + idade + sexo + sozinho,
data = treino, family = binomial)
vif_ad <- car::vif(modelo_aditivo)
vif_ad
# workflow do modelo final com ligação logit:
wf_final <- extract_workflow(resultados, id = "classe_sexo_logit")
# ajuste no treino e avaliação no teste:
ajuste_final <- last_fit(
wf_final,
split = split,
metrics = metricas_prob
)
metricas_teste <- collect_metrics(ajuste_final)
kable(
metricas_teste[, c(".metric", ".estimate")],
digits = 3,
col.names = c("Métrica", "Valor"),
caption = "Métricas do modelo final no conjunto de teste"
)
#| echo: false
# guardando os valores para o texto:
metrica <- metricas_teste$.metric
auc_teste <- metricas_teste$.estimate[metrica == "roc_auc"]
brier_teste <- metricas_teste$.estimate[metrica == "brier_class"]
acc_teste <- metricas_teste$.estimate[metrica == "accuracy"]
#| fig-height: 4
#| fig-cap: "Curva ROC do modelo final no conjunto de teste."
# probabilidades previstas no teste:
pred_teste <- collect_predictions(ajuste_final)
# curva roc, com vivo = "sim" como evento:
pred_teste |>
roc_curve(
truth = vivo,
.pred_sim,
event_level = "second"
) |>
autoplot()
# matriz de confusão (corte 0.5):
conf_mat(pred_teste, truth = vivo, estimate = .pred_class)
# sensibilidade e especificidade (vivo = "sim" como evento):
metricas_classe <- metric_set(
sensitivity,
specificity
)
tab_classif <- metricas_classe(
pred_teste,
truth = vivo,
estimate = .pred_class,
event_level = "second"
)
tab_classif
#| echo: false
sens <- tab_classif$.estimate[tab_classif$.metric == "sensitivity"]
espec <- tab_classif$.estimate[tab_classif$.metric == "specificity"]
#| fig-width: 8
#| fig-height: 4.5
#| fig-cap: "Probabilidade ajustada de sobreviver por classe e sexo (idade = 28 anos), com IC de 95%."
# probabilidades ajustadas por classe e sexo
idade_med <- median(treino$idade)
emm <- emmeans::emmeans(
modelo_final,
~ classe | sexo,
at = list(idade = idade_med)
)
tab_prob <- as.data.frame(summary(emm, type = "response"))
ggplot(tab_prob, aes(x = classe, y = prob, color = sexo, group = sexo)) +
geom_line() +
geom_point(size = 2.5) +
geom_errorbar(aes(ymin = asymp.LCL, ymax = asymp.UCL), width = 0.1) +
scale_y_continuous(labels = scales::percent, limits = c(0, 1)) +
labs(x = "Classe", y = "Probabilidade de sobreviver", color = "Sexo")
# classes comparadas dentro de cada sexo
pairs(emm, type = "response")
# sexos comparados dentro de cada classe
emm2 <- emmeans::emmeans(
modelo_final,
~ sexo | classe,
at = list(idade = idade_med)
)
pairs(emm2, type = "response")
# razões de chances e ic de 95% (wald):
b <- coef(modelo_final)
se <- sqrt(diag(vcov(modelo_final)))
z <- qnorm(0.975)
tab_or <- data.frame(
coef = b,
OR = exp(b),
IC_inf = exp(b - z * se),
IC_sup = exp(b + z * se)
)[-1, ]
kable(
tab_or,
digits = 3,
col.names = c("Coeficiente", "OR", "IC inferior 95%", "IC superior 95%"),
caption = "Coeficientes, razões de chances e IC de 95% (Wald)"
)
# carregando os pacotes
library(tidyverse)
library(patchwork)
library(knitr)
library(scales)
library(tidymodels)
library(car)
library(reglin)
# Carregando os dados
df_titanic <- read_csv("titanic.csv")
kable(head(df_titanic), caption = "Primeiras linhas do banco de dados")
# Número de observações e valores faltantes
n_obs <- nrow(df_titanic)
n_obs
anyNA(df_titanic)
# Transformando as variáveis categóricas em fatores
df_titanic <- df_titanic |>
mutate(
vivo = factor(vivo, levels = c("nao", "sim")),
classe = factor(classe, levels = c("I", "II", "III"), ordered = FALSE),
sexo = factor(sexo, levels = c("feminino", "masculino")),
sozinho = factor(sozinho, levels = c("nao", "sim"))
)
# Conferindo a transformação
sapply(df_titanic, class)
# Conferindo o nível de referência (o primeiro nível é a referência)
sapply(df_titanic, levels)
# Proporção de vivos e mortos
contagem <- table(df_titanic$vivo)
contagem
tab_vivo <- round(prop.table(contagem) * 100, 2)
kable(tab_vivo, caption = "Proporção de vivos no banco de dados (em %)",
col.names = c("Vivo", "%"))
#| fig-height: 3.6
# Histograma, boxplot e boxplot por grupo de vivo
g_hist <- ggplot(df_titanic, aes(x = idade, y = after_stat(density))) +
geom_histogram(color = "white", fill = "dodgerblue2", binwidth = 5) +
labs(x = "Idade", y = "Densidade", title = "Histograma")
g_box <- ggplot(df_titanic, aes(x = "", y = idade)) +
geom_boxplot(fill = "dodgerblue2", width = 0.4) +
labs(x = "", y = "Idade", title = "Boxplot")
g_box_vivo <- ggplot(df_titanic, aes(x = vivo, y = idade)) +
geom_boxplot(fill = "dodgerblue2", width = 0.4) +
labs(x = "Vivo", y = "Idade", title = "Boxplot por vivo")
g_hist | g_box | g_box_vivo
# outliers (regra do boxplot):
outliers_idade <- boxplot.stats(df_titanic$idade)$out
n_outliers <- length(outliers_idade)
# Média e variância da idade, por grupo de vivo e no total
desc_idade <- df_titanic |>
group_by(vivo) |>
summarise(n = n(), media = mean(idade), variancia = var(idade),
mediana = median(idade), minimo = min(idade), maximo = max(idade))
media_idade <- mean(df_titanic$idade)
kable(desc_idade, digits = 1,
col.names = c("Vivo", "n", "Média", "Variância", "Mediana", "Mínimo", "Máximo"),
caption = "Medidas descritivas da idade por grupo de sobrevivência")
#| fig-height: 3.5
# Taxa de sobrevivência por faixa etária
df_titanic <- df_titanic |>
mutate(
faixa_etaria = cut(idade, breaks = c(0, 12, 18, 30, 45, 60, Inf),
labels = c("0-12", "13-18", "19-30", "31-45", "46-60", "61+"),
include.lowest = TRUE)
)
tab_faixa <- table(df_titanic$faixa_etaria, df_titanic$vivo)
prop_faixa <- round(100 * prop.table(tab_faixa, margin = 1), 1)
g_faixa <- ggplot(df_titanic, aes(x = faixa_etaria, fill = vivo)) +
geom_bar(position = "fill") +
scale_fill_brewer(palette = "Paired") +
scale_y_continuous(labels = scales::percent) +
labs(title = "Proporção de vivos por faixa etária", x = "Faixa etária", y = "Proporção", fill = "Vivo")
g_faixa
#| fig-height: 5
# Gráficos da proporção de vivos por categoria
tab_sexo <- table(df_titanic$sexo, df_titanic$vivo)
tab_classe <- table(df_titanic$classe, df_titanic$vivo)
tab_sozinho <- table(df_titanic$sozinho, df_titanic$vivo)
prop_sexo <- round(100 * prop.table(tab_sexo, margin = 1), 1)
prop_classe <- round(100 * prop.table(tab_classe, margin = 1), 1)
prop_sozinho <- round(100 * prop.table(tab_sozinho, margin = 1), 1)
g_sexo <- ggplot(df_titanic, aes(x = sexo, fill = vivo)) +
geom_bar(position = "fill") +
scale_fill_brewer(palette = "Paired") +
scale_y_continuous(labels = scales::percent) +
labs(title = "Sexo", x = "Sexo", y = "Proporção", fill = "Vivo")
g_classe <- ggplot(df_titanic, aes(x = classe, fill = vivo)) +
geom_bar(position = "fill") +
scale_fill_brewer(palette = "Paired") +
scale_y_continuous(labels = scales::percent) +
labs(title = "Classe", x = "Classe", y = "Proporção", fill = "Vivo")
g_sozinho <- ggplot(df_titanic, aes(x = sozinho, fill = vivo)) +
geom_bar(position = "fill") +
scale_fill_brewer(palette = "Paired") +
scale_y_continuous(labels = scales::percent) +
labs(title = "Sozinho", x = "Sozinho", y = "Proporção", fill = "Vivo")
(g_sexo | g_classe) / g_sozinho + plot_layout(guides = "collect")
#| fig-height: 3.5
# proporção de vivos por classe, separada por sexo:
ggplot(df_titanic, aes(x = classe, fill = vivo)) +
geom_bar(position = "fill") +
facet_wrap(~ sexo) +
scale_fill_brewer(palette = "Paired") +
scale_y_continuous(labels = scales::percent) +
labs(title = "Classe por sexo", x = "Classe", y = "Proporção", fill = "Vivo")
#| fig-height: 3.5
# proporção de vivos por faixa-etária, separada por sexo:
ggplot(df_titanic, aes(x = faixa_etaria, fill = vivo)) +
geom_bar(position = "fill") +
facet_wrap(~ sexo) +
scale_fill_brewer(palette = "Paired") +
scale_y_continuous(labels = scales::percent) +
labs(title = "Faixa etária por sexo", x = "Faixa-Etária", y = "Proporção", fill = "Vivo") +
scale_x_discrete(guide = guide_axis(n.dodge = 2))
set.seed(2026)
split <- initial_split(df_titanic, prop = 0.75, strata = vivo)
split
treino <- training(split)
teste <- testing(split)
# modelo com todas as interações de 2ª ordem, ajustado no treino
m1 <- glm(vivo ~ (classe + sexo + idade + sozinho)^2,
data = treino, family = binomial)
step_aic <- stats::step(m1, direction = "backward", trace = 0)
step_bic <- stats::step(m1, direction = "backward", trace = 0, k = log(nrow(treino)))
# modelos selecionados:
formula(step_aic)
formula(step_bic)
# teste da razão de verossimilhanças para cada termo (Anova tipo II)
mod_sel <- glm(vivo ~ classe * sexo + idade, data = treino, family = binomial)
car::Anova(mod_sel, type = "II")
# Checando se a interação idade:sexo acrescentaria algo
mod_sexo_idade <- glm(vivo ~ classe * sexo + idade * sexo,
data = treino, family = binomial)
anova(mod_sel, mod_sexo_idade, test = "Chisq")
# Checando se `sozinho` acrescentaria algo
mod_sozinho <- update(mod_sel, . ~ . + sozinho)
anova(mod_sel, mod_sozinho, test = "Chisq")
# preditores lineares candidatos:
formulas <- list(
aditivo      = vivo ~ classe + sexo + idade + sozinho,
principais   = vivo ~ classe + sexo + idade,
classe_sexo  = vivo ~ idade + classe * sexo,
sexo_idade   = vivo ~ classe + sexo * idade,
classe_idade = vivo ~ sexo + classe * idade,
duas_inter   = vivo ~ idade * sexo + classe * sexo,
todas_inter  = vivo ~ (classe + sexo + idade + sozinho)^2
)
tibble(
Candidato = names(formulas),
`Preditor linear` = map_chr(formulas, deparse1)
) |>
kable(caption = "Preditores lineares candidatos")
set.seed(2026)
vfolds <- vfold_cv(treino, v = 10, repeats = 5, strata = vivo)
# Regressão logística (default), probit e complemento log-log
logit <- logistic_reg() |>
set_engine("glm")
probit <- logistic_reg() |>
set_engine("glm", family = stats::binomial(link = "probit"))
cloglog <- logistic_reg() |>
set_engine("glm", family = stats::binomial(link = "cloglog"))
# preditores x ligações
modelos <- workflow_set(
preproc = formulas,
models = list(
logit = logit,
probit = probit,
cloglog = cloglog
)
)
metricas_prob <- metric_set(roc_auc, brier_class, accuracy)
ctrl <- control_resamples(save_pred = TRUE)
resultados <- workflow_map(
modelos,
fn = "fit_resamples",
resamples = vfolds,
metrics = metricas_prob,
control = ctrl,
verbose = TRUE
)
metricas_cv <- collect_metrics(resultados)
metricas_cv |>
filter(.metric == "roc_auc") |>
arrange(desc(mean)) |>
select(Candidato = wflow_id, AUC = mean, `Erro padrão` = std_err) |>
kable(digits = 4, caption = "AUC médio na validação cruzada, por candidato")
# métricas médias dos dois finalistas
metricas_cv |>
filter(wflow_id %in% c("duas_inter_logit", "classe_sexo_logit")) |>
select(Candidato = wflow_id, Métrica = .metric, Média = mean, `Erro padrão` = std_err) |>
arrange(Métrica, Candidato) |>
kable(digits = 4, caption = "Métricas na validação cruzada: duas_inter vs. classe_sexo")
#| echo: false
melhor_modelo <- metricas_cv |>
filter(.metric == "roc_auc") |>
slice_max(order_by = mean, n = 1, with_ties = FALSE)
melhor_id <- "classe_sexo_logit"
melhor <- extract_workflow(resultados, id = melhor_id)
# ajuste no treino e extração do glm
final <- melhor |>
fit(data = treino)
final_glm <- final |>
extract_fit_parsnip() |>
extract_fit_engine()
link_final <- str_extract(melhor_id, "(logit|probit|cloglog)$")
# guardando os valores
